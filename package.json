{
  "name": "streak-maintaining-extension",
  "description": "A Chrome extension for daily learning habits.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test:account": "node scripts/account.mjs",
    "test:cloud": "node scripts/cloud.mjs",
    "test:reminders": "node scripts/reminders.mjs",
    "test:ingestion": "node scripts/ingestion.mjs",
    "test:database": "node scripts/database.mjs",
    "test:recovery": "node scripts/recovery.mjs",
    "test:reading": "node scripts/reading.mjs",
    "test:reading:browser": "node scripts/reading-smoke.mjs",
    "test:streaks": "node scripts/streaks.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "postinstall": "wxt prepare",
    "test:history": "node scripts/history.mjs",
    "test:privacy": "node scripts/privacy-database.mjs && node scripts/privacy.mjs",
    "check": "node scripts/check.mjs",
    "test:config": "node scripts/config.mjs",
    "test:release": "node scripts/release.mjs",
    "test:site": "node scripts/reading-smoke.mjs --live"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
